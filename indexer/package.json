{
  "name": "@ggpoker/event-indexer",
  "version": "1.0.0",
  "description": "Event-driven indexer replacing Go p2p layer — subscribes to PokerGame.sol events via WebSocket",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
